{
  "name": "zaozao-scriber",
  "version": "0.1.0",
  "description": "Bot que grava sessões de RPG em canais de voz do Discord e transcreve em texto narrativo",
  "author": "ZaoZao",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node src/registerCommands.js",
    "transcribe": "node src/transcribe.js",
    "narrate": "node src/narrateOnly.js",
    "app": "electron .",
    "build:app": "electron-builder --win"
  },
  "build": {
    "appId": "com.zaozao.scriber",
    "productName": "ZaoZao Scriber",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "config.yaml",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.19.2",
    "@lumen-labs-dev/whisper-node": "^0.4.1",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "prism-media": "^2.0.0-alpha.0",
    "sodium-native": "^5.1.0",
    "wav": "^1.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "@discordjs/opus@0.9.0": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
